#!/bin/sh /etc/rc.common
# The Unisoc sound card and its DSP: the audio extra's drivers, the DMA engine they need, a bind to finish the card,
# and the firmware write that brings the audio DSP up. "start" is safe in this order and only in this order - it
# checks the card is registered first, because writing the reset registers with the AGDSP power domain down reboots
# the device (see /opt/mu300/bin/mu300-audio-dsp and mu300-linux FINDINGS 24). Put here by the audio extra's
# hooks/link (mu300-extra install audio).
START=14
USE_PROCD=1
export PATH="$PATH:/opt/mu300/busybox-bin"

boot() {
	# In the background, like the rest of the hardware bring-up: binding the card takes about half a minute
	# of waiting on probes, and busybox init does not spawn the consoles until sysinit has returned.
	[ -x /opt/mu300/bin/mu300-audio-dsp ] || return 0
	(/opt/mu300/bin/mu300-audio-dsp start > /tmp/mu300-audio.log 2>&1) &
}

start_service() { :; }
