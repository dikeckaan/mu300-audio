#!/bin/sh /etc/rc.common
# Call audio: follow calls, route them through the audio DSP (and a Bluetooth headset). After mu300-audio (14).
START=96
STOP=10
USE_PROCD=1

start_service() {
	[ -f /lib/firmware/agdsp.bin ] || return 0
	procd_open_instance
	procd_set_param command /opt/mu300/bin/mu300-voice watch
	procd_set_param env PATH="/usr/sbin:/usr/bin:/sbin:/bin:/opt/mu300/bin:/opt/mu300/busybox-bin"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
