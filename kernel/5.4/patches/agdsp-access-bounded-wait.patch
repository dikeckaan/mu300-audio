+/*
+ * MU300: wait for the AGDSP power domain, never with a lock held and never for long. This driver polled the PMU up to
+ * 1000000 times under dsp_ac->spin_lock, about 6 s, and the domain does not come up before the DSP runs its image:
+ * the card's bind reads the codec's digital registers one by one before mu300-audio-dsp has written the firmware,
+ * each read held a CPU for 6 s, and binding the card took two minutes (19 reads) - twice, when mu300-audio-dsp
+ * rebound it. A domain that comes up does so within tens of microseconds. Callers that may sleep poll with
+ * usleep_range() for up to 200 ms; atomic ones (a trigger) spin for at most 2 ms. A timeout is an error the caller
+ * sees (-EBUSY), not a hang. The same as the mainline port's (kernel/mainline, mu300-linux FINDINGS 188).
+ */
+#define AGDSP_WAKE_TIMEOUT_US		200000
+#define AGDSP_WAKE_TIMEOUT_ATOMIC_US	2000
+
+static int agdsp_wait_powered_us(struct agdsp_access *dsp_ac, bool may_sleep,
+				 unsigned int timeout_us)
+{
+	u32 mask = dsp_ac->audcp_pmu_sys_slp_state_mask;
+	u32 shift = ffs(mask) - 1;
+	ktime_t end = ktime_add_us(ktime_get(), timeout_us);
+	u32 val;
+	int ret;
+
+	for (;;) {
+		ret = regmap_read(dsp_ac->pmu_apb,
+			dsp_ac->audcp_pmu_pwr_status4_reg, &val);
+		if (ret)
+			return ret;
+		/* 0: power up finished;7:power off */
+		if (((val & mask) >> shift) == PD_WAKEUP_STATE)
+			return 0;
+		if (ktime_after(ktime_get(), end))
+			return -ETIMEDOUT;
+		if (may_sleep)
+			usleep_range(50, 100);
+		else
+			udelay(5);
+	}
+}
+
+static int agdsp_wait_powered(struct agdsp_access *dsp_ac)
+{
+	if (preemptible())
+		return agdsp_wait_powered_us(dsp_ac, true, AGDSP_WAKE_TIMEOUT_US);
+	return agdsp_wait_powered_us(dsp_ac, false, AGDSP_WAKE_TIMEOUT_ATOMIC_US);
+}
 
+/* with dsp_ac->spin_lock held: give back one count, and the access bit with the last one */
+static void agdsp_access_put_locked(struct agdsp_access *dsp_ac)
+{
+	if (AGCP_READL(&dsp_ac->state->ap_enable_cnt) > 0)
+		AGCP_WRITEL(AGCP_READL(&dsp_ac->state->ap_enable_cnt) - 1,
+			&dsp_ac->state->ap_enable_cnt);
+	if (!dsp_ac->auto_agcp_access &&
+	    AGCP_READL(&dsp_ac->state->ap_enable_cnt) == 0)
+		regmap_update_bits(dsp_ac->agcp_ahb, dsp_ac->ap_access_ena_reg,
+				   dsp_ac->ap_access_ena_mask, 0);
+}
